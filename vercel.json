{
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.7.2" }
  },
  "rewrites": [
    { "source": "/emporio",        "destination": "/api/emporio/index.php" },
    { "source": "/emporio/",       "destination": "/api/emporio/index.php" },
    { "source": "/emporio/:path*", "destination": "/api/emporio/:path*" }
  ]
}
